@model LoginViewModel
@{
    ViewData["Title"] = "Log In";
}

<div class="row justify-content-center py-5 animate-fade-in-up">
    <div class="col-md-5">
        <div class="glass-card p-5">
            <div class="text-center mb-4">
                <i class="bi bi-shield-lock-fill text-primary display-4 mb-2"></i>
                <h2 class="fw-bold" style="font-family: 'Outfit', sans-serif;">Welcome Back</h2>
                <p class="text-secondary small">Access your resume analyses</p>
            </div>

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control bg-transparent" type="email" placeholder="name@example.com" required />
                    <label asp-for="Email"></label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Password" class="form-control bg-transparent" type="password" placeholder="Password" required />
                    <label asp-for="Password"></label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="RememberMe" />
                        <label class="form-check-label small text-secondary" asp-for="RememberMe">
                            Remember me
                        </label>
                    </div>
                    <a asp-action="ForgotPassword" class="small text-decoration-none">Forgot Password?</a>
                </div>

                <button type="submit" class="btn btn-primary-gradient w-100 py-3 mb-3">Log In</button>
            </form>

            <div class="text-center">
                <span class="text-secondary small">New to our platform? </span>
                <a asp-action="Register" class="small text-decoration-none">Create Account</a>
            </div>
        </div>
    </div>
</div>
