@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center py-5 animate-fade-in-up">
    <div class="col-md-5">
        <div class="glass-card p-5">
            <div class="text-center mb-4">
                <i class="bi bi-key-fill text-primary display-4 mb-2"></i>
                <h2 class="fw-bold" style="font-family: 'Outfit', sans-serif;">Reset Password</h2>
                <p class="text-secondary small">Enter your email to receive a password reset link</p>
            </div>

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-success border-0 rounded-3 mb-4 small" role="alert">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    @ViewBag.Message
                </div>
                <div class="text-center">
                    <a asp-action="Login" class="btn btn-outline-secondary w-100 py-3 mt-2">Back to Login</a>
                </div>
            }
            else
            {
                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="form-floating mb-4">
                        <input asp-for="Email" class="form-control bg-transparent" type="email" placeholder="name@example.com" required />
                        <label asp-for="Email"></label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary-gradient w-100 py-3 mb-3">Send Reset Link</button>
                </form>

                <div class="text-center">
                    <a asp-action="Login" class="small text-decoration-none">Back to Login</a>
                </div>
            }
        </div>
    </div>
</div>
