@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Control Panel";
}

<div class="row mb-5 animate-fade-in-up">
    <div class="col-12">
        <h1 class="fw-extrabold" style="font-family: 'Outfit', sans-serif;">Admin Control Panel</h1>
        <p class="text-secondary mb-0">Platform usage analytics, billing dashboard, and user tier controls</p>
    </div>
</div>

<!-- Key Platform Metrics -->
<div class="row g-4 mb-5 animate-fade-in-up" style="animation-delay: 0.1s;">
    <div class="col-md-3">
        <div class="glass-card p-4 h-100">
            <span class="text-secondary small fw-semibold text-uppercase tracking-wider d-block mb-1">Total Users</span>
            <span class="display-5 fw-bold" style="font-family: 'Outfit', sans-serif;">@Model.TotalUsers</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-4 h-100">
            <span class="text-secondary small fw-semibold text-uppercase tracking-wider d-block mb-1">Total Audits</span>
            <span class="display-5 fw-bold" style="font-family: 'Outfit', sans-serif;">@Model.TotalResumes</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-4 h-100">
            <span class="text-secondary small fw-semibold text-uppercase tracking-wider d-block mb-1">Average ATS Score</span>
            <span class="display-5 fw-bold text-primary" style="font-family: 'Outfit', sans-serif;">@Model.AverageAtsScore%</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-4 h-100">
            <span class="text-secondary small fw-semibold text-uppercase tracking-wider d-block mb-1">Est. MRR</span>
            <span class="display-5 fw-bold text-success" style="font-family: 'Outfit', sans-serif;">$@Model.MonthlyRevenue.ToString("N2")</span>
        </div>
    </div>
</div>

<!-- Charts & Users List -->
<div class="row g-4 mb-5 animate-fade-in-up" style="animation-delay: 0.2s;">
    <!-- Subscriber Distribution Chart -->
    <div class="col-lg-4">
        <div class="glass-card p-4 h-100">
            <h4 class="fw-bold mb-4" style="font-family: 'Outfit', sans-serif;">Subscription Tiers</h4>
            <div style="height: 250px; position: relative;">
                <canvas id="subscriptionChart"></canvas>
            </div>
        </div>
    </div>

    <!-- User Management Table -->
    <div class="col-lg-8">
        <div class="glass-card p-4 h-100">
            <h4 class="fw-bold mb-4" style="font-family: 'Outfit', sans-serif;">User Accounts</h4>
            <div class="table-responsive">
                <table class="table glass-table align-middle">
                    <thead>
                        <tr>
                            <th>User Details</th>
                            <th>Tier Settings</th>
                            <th class="text-center">Usage (Mo)</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Users.Any())
                        {
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-truncate" style="max-width: 180px;">@user.FullName</div>
                                        <span class="text-muted small">@user.Email</span>
                                    </td>
                                    <td>
                                        <form asp-action="UpdateSubscription" method="post" class="d-flex align-items-center gap-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.UserId" />
                                            <select name="planId" class="form-select form-select-sm bg-transparent w-auto" onchange="this.form.submit()">
                                                <option value="1" selected='@(user.SubscriptionTier == "Free")'>Free</option>
                                                <option value="2" selected='@(user.SubscriptionTier == "Pro")'>Pro</option>
                                                <option value="3" selected='@(user.SubscriptionTier == "Enterprise")'>Enterprise</option>
                                            </select>
                                        </form>
                                    </td>
                                    <td class="text-center fw-semibold text-secondary">
                                        @user.UsageThisMonth
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Are you sure you want to permanently delete this user?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.UserId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger px-3 rounded-pill">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">No users found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const ctx = document.getElementById('subscriptionChart');
            if (!ctx) return;

            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Free', 'Pro', 'Enterprise'],
                    datasets: [{
                        data: [@Model.FreeUsersCount, @Model.ProUsersCount, @Model.EnterpriseUsersCount],
                        backgroundColor: ['#94a3b8', '#2563eb', '#06b6d4'],
                        borderWidth: 2,
                        borderColor: 'transparent'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                font: { family: 'Inter' }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
