@model IEnumerable<HistoryItemViewModel>
@{
    ViewData["Title"] = "Analysis History";
}

<div class="row mb-5 animate-fade-in-up">
    <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="fw-extrabold" style="font-family: 'Outfit', sans-serif;">Analysis History</h1>
            <p class="text-secondary mb-0">List of all your uploaded resumes and past ATS match reports</p>
        </div>
        <a asp-action="Upload" class="btn btn-primary-gradient px-4 py-3">
            <i class="bi bi-cloud-arrow-up-fill me-2"></i>New Audit
        </a>
    </div>
</div>

<div class="row animate-fade-in-up" style="animation-delay: 0.1s;">
    <div class="col-12">
        <div class="glass-card p-5">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table glass-table align-middle">
                        <thead>
                            <tr>
                                <th>File Name</th>
                                <th>Target Position</th>
                                <th>Date Audited</th>
                                <th class="text-center">ATS Score</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold d-flex align-items-center">
                                            <i class="bi bi-file-earmark-pdf-fill text-danger fs-4 me-2"></i>
                                            @item.ResumeName
                                        </div>
                                    </td>
                                    <td>@item.JobTitle</td>
                                    <td>@item.DateAnalyzed.ToString("MMM dd, yyyy - hh:mm tt")</td>
                                    <td class="text-center">
                                        <span class="badge @(item.AtsScore >= 90 ? "badge-excellent" : (item.AtsScore >= 70 ? "badge-good" : (item.AtsScore >= 50 ? "badge-average" : "badge-poor"))) rounded-pill px-3 py-2">
                                            @item.AtsScore%
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-action="Result" asp-route-id="@item.AnalysisId" class="btn btn-sm btn-outline-primary px-3 rounded-pill">
                                                View Report
                                            </a>
                                            <a href="@item.BlobUrl" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Download Resume">
                                                <i class="bi bi-download"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.AnalysisId" method="post" onsubmit="return confirm('Are you sure you want to delete this analysis record?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle px-2" title="Delete record">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-file-earmark-person-fill text-muted display-3 mb-3 d-block"></i>
                    <h3 class="fw-bold">No Records Yet</h3>
                    <p class="text-secondary mb-4">You have not uploaded or analyzed any resumes.</p>
                    <a asp-action="Upload" class="btn btn-primary-gradient px-4 py-3">Analyze Your First Resume</a>
                </div>
            }
        </div>
    </div>
</div>
